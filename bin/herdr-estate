#!/usr/bin/env python3
"""herdr-estate: resume a campaign's latest conversation, start fresh, or
list what the estate table knows.

  herdr-estate resume [<address>] [--dry-run]
  herdr-estate fresh  [<address>] [--dry-run]
  herdr-estate list

<address> is estate/campaign, e.g. home/garden. When run as a herdr
plugin action with no address, it is derived from the current
workspace's label.
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from herdr_estate.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
